# ==========================================================
# KONFIGURASI LINGKUNGAN APLIKASI (PORTFOLIO DEMO)
# ==========================================================
# Mode aplikasi: 'demo' (default) atau 'production'
# Pada mode 'demo', seluruh koneksi ke database produksi diblokir total.
APP_ENV=demo

# Jenis database: 'sqlite' (default untuk portofolio)
DB_TYPE=sqlite
SQLITE_DB_PATH=data/demo_klinik.db

# ==========================================================
# KREDENSIAL GOOGLE GEMINI (AI BUSINESS CONSULTANT)
# ==========================================================
# Masukkan API Key Gemini Anda di bawah ini untuk mengaktifkan AI Assistant.
# Dapatkan API Key gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Model gratis yang didukung: gemini-3.5-flash-lite (default cepat & kuota lega) atau gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
